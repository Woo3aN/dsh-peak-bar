{
  "name": "dsh-peak-bar",
  "version": "0.3.0",
  "description": "窗口标题栏居中的一枚小胶囊：DeepSeek API 峰谷时段、账户余额与今日已用；颜色跟随当前皮肤。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "balance",
    "peak",
    "off-peak",
    "countdown",
    "titlebar",
    "caption"
  ],
  "author": "Woo3aN",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Woo3aN/dsh-peak-bar.git"
  },
  "bugs": {
    "url": "https://github.com/Woo3aN/dsh-peak-bar/issues"
  },
  "homepage": "https://github.com/Woo3aN/dsh-peak-bar#readme",
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "locale/*.json",
    "tests",
    "docs",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/peak.test.mjs && node tests/render.test.mjs && node tests/host.test.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
